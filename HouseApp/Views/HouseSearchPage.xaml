<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:HouseApp.ViewModels"
             x:Class="HouseApp.Views.HouseSearchPage"
             x:DataType="viewmodels:HouseSearchViewModel"
             BackgroundColor="#F5F6FA"
             Title="Find Your House">

    <Grid RowDefinitions="Auto,*">
        
        <!-- Header with Back Button -->
        <Grid Grid.Row="0" BackgroundColor="#6D28D9" Padding="16,12">
            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                <Button Text="←" 
                        FontSize="24"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        Clicked="OnBackButtonClicked"/>
                <Label Text="Find Your House" 
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="White"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Grid>

    <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="20" Spacing="16">
            
            <!-- Header -->
            <Label Text="Join a House" 
                   FontSize="24" 
                   FontAttributes="Bold"
                   TextColor="#111827"
                   Margin="0,20,0,10"/>
            
            <Label Text="Enter the house code provided by your landlord to join." 
                   FontSize="14" 
                   TextColor="#6B7280"
                   Margin="0,0,0,20"/>

            <!-- House Code Input -->
            <Label Text="House Code" 
                   FontSize="14" 
                   TextColor="#6B7280" 
                   Margin="0,8,0,4"/>
            
            <Border StrokeThickness="1" 
                    Stroke="#E5E7EB" 
                    BackgroundColor="White"
                    Padding="12"
                    Margin="0,8"
                    StrokeShape="RoundRectangle 8">
                <Entry Placeholder="Enter 6-digit house code (e.g., ABCD12)"
                       Text="{Binding HouseCode}"
                       TextColor="#111827"
                       PlaceholderColor="#9CA3AF"
                       BackgroundColor="Transparent"
                       FontSize="16"
                       MaxLength="6"/>
            </Border>

            <!-- Join Button -->
            <Button Text="Join House"
                    Command="{Binding JoinHouseCommand}"
                    BackgroundColor="#6D28D9"
                    TextColor="White"
                    FontSize="16"
                    CornerRadius="8"
                    HeightRequest="50"
                    Margin="0,10"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"/>

            <!-- Activity Indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}" 
                             Color="#6D28D9"
                             Margin="0,20"
                             IsVisible="{Binding IsLoading}"/>

            <!-- Info Box -->
            <Border StrokeThickness="1" 
                    Stroke="#E5E7EB" 
                    BackgroundColor="#F9FAFB"
                    Padding="16"
                    Margin="0,20,0,0"
                    StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="ℹ️ How to Join" 
                           FontSize="16" 
                           FontAttributes="Bold"
                           TextColor="#111827"/>
                    <Label FontSize="14" TextColor="#6B7280" LineBreakMode="WordWrap">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="1. Get the house code from your landlord&#10;"/>
                                <Span Text="2. Enter the 6-digit code above&#10;"/>
                                <Span Text="3. Click 'Join House' to send your request"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
    </Grid>
</ContentPage>
